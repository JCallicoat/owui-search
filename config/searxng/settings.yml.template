# SearXNG settings. Only overrides are listed here; everything else comes
# from SearXNG's built-in defaults (use_default_settings).
use_default_settings: true

server:
  # Generated by install.sh. Changing it clears SearXNG's internal caches.
  secret_key: "@SECRET_KEY@"
  # Only reachable from host loopback, so the bot limiter is not needed.
  limiter: false
  image_proxy: false

search:
  # Open WebUI needs the JSON format; without it requests get a 403.
  formats:
    - html
    - json
  # Favicons in SearXNG's own web UI (not used by Open WebUI's JSON requests).
  # Remove this line to disable favicons and their cache entirely.
  favicon_resolver: "duckduckgo"
