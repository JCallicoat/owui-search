[Unit]
Description=llama.cpp server (OpenAI-compatible API on 127.0.0.1:10000)
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server

[Service]
Type=simple
# llama-server binds to 127.0.0.1 by default; Open WebUI reaches it through
# the owui pod's pasta forward. API requests need the key in the key file
# (generated by install.sh); /health and the web UI's static files don't.
ExecStart=/usr/bin/llama-server --models-preset %h/models/models.ini --models-max 1 --port 10000 --embeddings --api-key-file @CONFIG_HOME@/llama-server/api-key
Restart=on-failure
RestartSec=5
# Leave time to unload models cleanly.
TimeoutStopSec=60
